# Change these before deployment. Never commit your real .env file.
ADMIN_EMAIL=admin@reincrew.local
ADMIN_PASSWORD=ChangeThisStrongPassword

# SMTP email settings (example: Gmail SMTP with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM=your-email@gmail.com

# Optional persistent database path
DATABASE_PATH=data/reincrew.db
